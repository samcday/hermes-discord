#!/usr/bin/env bash
set -euo pipefail
if (( EUID == 0 )); then
    # Drop privileges before using the agent-controlled HOME, PATH, or runtime.
    exec /usr/sbin/runuser -u hermes -- /usr/local/libexec/hermes-voice/agent "$@"
fi
[[ $(id -un) == hermes ]] || exit 1
export HOME=/var/lib/hermes
export HERMES_HOME="$HOME/.hermes"
export HF_HOME="$HOME/.cache/huggingface"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin"
cd "$HOME"
exec "$HERMES_HOME/hermes-agent/.hermes/bin/hermes" "$@"
